# Copy to backend/.env and fill in. Never commit backend/.env.
# Supabase project URL and a BACKEND-ONLY key (never put it in a NEXT_PUBLIC_* variable).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
# OpenAI does scoring and the call brief; Perplexity does the web research.
OPENAI_API_KEY=sk-your-openai-key
PERPLEXITY_API_KEY=pplx-your-perplexity-key
# Optional
OPENAI_MODEL=gpt-4o-mini
# Perplexity Agent API preset: fast (default, replaces Sonar), low, medium, high
PERPLEXITY_PRESET=fast
PIPELINE_CONCURRENCY=8
# Optional: comma-separated browser origins allowed by CORS (default below)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
